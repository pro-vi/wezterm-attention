{
  "provider": "claude",
  "base": {
    "session_id": "claude-session-a",
    "transcript_path": "/tmp/claude-session-a.jsonl",
    "cwd": "/tmp/project",
    "hook_event_name": "SessionStart",
    "model": "opus"
  },
  "cases": [
    { "id": "startup_binding", "event": "SessionStart", "patch": { "source": "startup" }, "expected": "binding" },
    { "id": "resume_binding", "event": "SessionStart", "patch": { "source": "resume" }, "expected": "binding" },
    { "id": "clear_binding", "event": "SessionStart", "patch": { "source": "clear" }, "expected": "binding" },
    { "id": "fork_binding", "event": "SessionStart", "patch": { "source": "fork" }, "expected": "binding" },
    { "id": "compact_confirmation", "event": "SessionStart", "patch": { "source": "compact" }, "expected": "binding" },
    { "id": "root_tool_activity", "event": "PreToolUse", "patch": { "tool_name": "Bash" }, "expected": "activity", "activity_type": "thinking" },
    { "id": "root_prompt_activity", "event": "UserPromptSubmit", "patch": {}, "expected": "activity", "activity_type": "thinking" },
    { "id": "child_prompt_observation", "event": "UserPromptSubmit", "patch": { "agent_id": "child-a", "agent_type": "Explore" }, "expected": "observation" },
    { "id": "no_launch_non_start_is_stale", "event": "PreToolUse", "patch": { "tool_name": "Bash" }, "expected": "activity", "activity_type": "thinking", "lifecycle_diagnostic": "claim_stale" },
    { "id": "child_tool_activity", "event": "PreToolUse", "patch": { "tool_name": "Bash", "agent_id": "child-a", "agent_type": "Explore" }, "expected": "child_active" },
    { "id": "child_permission_notifies", "event": "PermissionRequest", "patch": { "tool_name": "Bash", "agent_id": "child-a", "agent_type": "Explore" }, "expected": "activity", "activity_type": "notify" },
    { "id": "root_permission_activity", "event": "PermissionRequest", "patch": { "tool_name": "Bash" }, "expected": "activity", "activity_type": "notify" },
    { "id": "root_notification_activity", "event": "Notification", "patch": { "notification_type": "permission_prompt" }, "expected": "activity", "activity_type": "notify" },
    { "id": "idle_notification_is_inert", "event": "Notification", "patch": { "notification_type": "idle_prompt" }, "expected": "ignored" },
    { "id": "root_stop_activity", "event": "Stop", "patch": { "stop_hook_active": false }, "expected": "activity", "activity_type": "stop" },
    { "id": "root_failed_turn_notifies", "event": "StopFailure", "patch": { "error": "rate_limit" }, "expected": "activity", "activity_type": "notify" },
    { "id": "child_failed_turn_observation", "event": "StopFailure", "patch": { "error": "overloaded", "agent_id": "child-a", "agent_type": "Explore" }, "expected": "observation" },
    { "id": "child_stop_fence", "event": "SubagentStop", "patch": { "agent_id": "child-a", "agent_type": "Explore", "stop_hook_active": false }, "expected": "child_stopped" },
    { "id": "session_end", "event": "SessionEnd", "patch": { "reason": "other" }, "expected": "end" },
    { "id": "subagent_start_is_inert", "event": "SubagentStart", "patch": { "agent_id": "child-a", "agent_type": "Explore" }, "expected": "ignored" },
    { "id": "missing_stop_id_is_inert", "event": "SubagentStop", "patch": { "stop_hook_active": false }, "expected": "ignored", "diagnostic": "record_invalid" },
    { "id": "background_is_inert", "event": "SessionStart", "patch": { "source": "startup" }, "env": { "CLAUDE_JOB_DIR": "/tmp/job" }, "expected": "ignored" },
    { "id": "cursor_is_inert", "event": "SessionStart", "patch": { "source": "startup" }, "env": { "CURSOR_AGENT": "1" }, "expected": "ignored" },
    { "id": "unknown_source_is_inert", "event": "SessionStart", "patch": { "source": "mystery" }, "expected": "ignored", "diagnostic": "integration_version_mismatch" },
    { "id": "mismatched_event_name_is_inert", "event": "Stop", "patch": { "hook_event_name": "PreToolUse" }, "expected": "ignored", "diagnostic": "record_invalid" }
  ]
}
