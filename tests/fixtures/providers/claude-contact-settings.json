    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$WEZTERM_ATTENTION_ROOT/tests/provider_contact_hook.py\" claude SessionEnd",
            "timeout": 5
          }
        ]
