#!/bin/sh

set -eu

# Resolve the invocation through any symlinks first. Without this, a link from
# somewhere on PATH makes ROOT the link's grandparent rather than the checkout,
# and the binary below it is never found.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=${self%/*}/$target ;;
  esac
done

case $self in
  */*) script_dir=${self%/*} ;;
  *) script_dir=. ;;
esac
ROOT=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [ ! -x "$ROOT/libexec/attention-rs" ]; then
  printf '%s\n' 'attention: Rust binary is missing; run scripts/install-cli.sh and retry.' >&2
  exit 3
fi

exec "$ROOT/libexec/attention-rs" "$@"
