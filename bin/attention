#!/bin/sh

set -eu

# Resolve the invocation through any symlinks first. Without this, a link from
# somewhere on PATH makes ROOT the link's grandparent rather than the checkout,
# and the binary below it is never found.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=${self%/*}/$target ;;
  esac
done

case $self in
  */*) script_dir=${self%/*} ;;
  *) script_dir=. ;;
esac
# -P, because a symlinked bin directory's logical parent is not the checkout.
ROOT=$(CDPATH= cd -P -- "$script_dir/.." && pwd -P)

if [ ! -x "$ROOT/libexec/attention-rs" ]; then
  printf 'attention: Rust binary is missing; run %s/scripts/install-cli.sh and retry.\n' "$ROOT" >&2
  # Provider hooks are registered globally and run wherever the agent runs. A
  # hook that cannot run here says so and exits 0, or 1 under --strict, as a
  # hook event with no pane identity does.
  if [ "${1:-}" = hooks ]; then
    for argument in "$@"; do
      [ "$argument" != --strict ] || exit 1
    done
    exit 0
  fi
  exit 1
fi

exec "$ROOT/libexec/attention-rs" "$@"
